-- Replace Id with a fresh GUID for every new plugin:
--   python3 -c "import uuid; print(uuid.uuid4())"
PluginInfo = {
  Name = "Nikita Visual Arts~Template",
  Version = "1.0.0",
  BuildVersion = "1.0.0.0",
  Id = "5b1f2a3c-9d4e-4f60-8a71-2c3d4e5f6a7b",
  Author = "Nikita Visual Arts – nikitavisual.art",
  Description = "Per-channel gain and mute with metering. Nikita Visual Arts – nikitavisual.art",
  ShowDebug = false,
}

-- ---------- Brand style ----------
Nikita = {
  Magenta = { 197,  19, 232 },
  Purple  = { 122,  27, 232 },
  Violet  = {  83,  18, 219 },
  Orange  = { 255, 138,  30 },
  Pink    = { 240,  50, 140 },
  BG      = {  23,  21,  28 },
  Panel   = {  32,  29,  38 },
  Stroke  = {  53,  49,  62 },
  Text    = { 244, 242, 247 },
  Muted   = { 167, 159, 179 },
  OK      = {  46, 204, 143 },
}
BrandName = "Nikita Visual Arts"
BrandSite = "nikitavisual.art"

NikitaAssets = {
  -- logo-icon.png, base64 (scripts/embed_image.py assets/brand/logo-icon.png)
  Icon = "",
}

-- ============================================================
-- Design time
-- ============================================================
function GetColor(props) return Nikita.BG end

function GetPrettyName(props)
  return string.format("Template %dch", props["Channel Count"].Value)
end

function GetProperties()
  return {
    { Name = "Channel Count", Type = "integer", Min = 1, Max = 8, Value = 2 },
    { Name = "Debug", Type = "boolean", Value = false },
  }
end

function RectifyProperties(props)
  return props
end

PageNames = { "Main" }

function GetPages(props)
  local pages = {}
  for _, name in ipairs(PageNames) do table.insert(pages, { name = name }) end
  return pages
end

-- Control defaults use DefaultValue; a `Value` key here is ignored by Q-SYS.
function GetControls(props)
  local n = props["Channel Count"].Value
  local ctls = {}
  table.insert(ctls, { Name = "Status", ControlType = "Indicator", IndicatorType = "Status", PinStyle = "Output", Count = 1 })
  table.insert(ctls, { Name = "Gain", ControlType = "Knob", ControlUnit = "dB", Min = -100, Max = 20, DefaultValue = 0, Count = n, PinStyle = "Both", UserPin = true })
  table.insert(ctls, { Name = "Mute", ControlType = "Button", ButtonType = "Toggle", Count = n, PinStyle = "Both", UserPin = true })
  table.insert(ctls, { Name = "Level", ControlType = "Indicator", IndicatorType = "Meter", Count = n, PinStyle = "Output" })
  return ctls
end

function GetControlLayout(props)
  local n = props["Channel Count"].Value
  local page = PageNames[props["page_index"].Value] or PageNames[1]
  local layout, graphics = {}, {}

  -- 8 px grid, 16 px margin, 48 px header band.
  local HEADER, M, G = 48, 16, 8
  local STRIP_W, STRIP_H = 72, 232
  local W = M + n * STRIP_W + M
  local H = HEADER + G + STRIP_H + M

  -- Layout key is the control Name, or "Name i" when Count > 1.
  local function idx(name, i, count) return name .. (count == 1 and "" or (" " .. i)) end

  -- Background and brand header (inserted first so everything else draws on top).
  table.insert(graphics, { Type = "GroupBox", Fill = Nikita.BG, StrokeWidth = 0, Position = { 0, 0 }, Size = { W, H } })
  table.insert(graphics, { Type = "GroupBox", Fill = Nikita.Panel, StrokeWidth = 0, Position = { 0, 0 }, Size = { W, HEADER } })
  table.insert(graphics, { Type = "Image", Image = NikitaAssets.Icon, Position = { M, 11 }, Size = { 26, 26 } })
  table.insert(graphics, { Type = "Label", Text = BrandName, FontSize = 13, FontStyle = "Bold", HTextAlign = "Left", Color = Nikita.Text, Position = { M + 32, 8 }, Size = { 180, 18 } })
  table.insert(graphics, { Type = "Label", Text = BrandSite, FontSize = 9, HTextAlign = "Left", Color = Nikita.Muted, Position = { M + 32, 26 }, Size = { 180, 14 } })
  layout["Status"] = { Style = "Led", Position = { W - M - 16, 16 }, Size = { 16, 16 } }

  if page == "Main" then
    for i = 1, n do
      local x = M + (i - 1) * STRIP_W
      local y = HEADER + G
      table.insert(graphics, { Type = "GroupBox", Fill = Nikita.Panel, StrokeColor = Nikita.Stroke, StrokeWidth = 1, CornerRadius = 4, Position = { x, y }, Size = { STRIP_W - G, STRIP_H } })
      table.insert(graphics, { Type = "Label", Text = string.format("CH %d", i), FontSize = 9, FontStyle = "Bold", HTextAlign = "Center", Color = Nikita.Muted, Position = { x, y + G }, Size = { STRIP_W - G, 14 } })
      layout[idx("Gain", i, n)] = { Style = "Fader", Color = Nikita.Purple, ShowTextbox = true, Position = { x + 12, y + 28 }, Size = { 28, 140 } }
      layout[idx("Level", i, n)] = { Style = "Meter", MeterStyle = "Level", ShowTextbox = false, Position = { x + 46, y + 28 }, Size = { 10, 140 } }
      layout[idx("Mute", i, n)] = { Style = "Button", ButtonStyle = "Toggle", Legend = "MUTE", Color = Nikita.Orange, UnlinkOffColor = true, OffColor = Nikita.BG, TextColor = Nikita.Text, FontSize = 9, CornerRadius = 4, Position = { x + 8, y + STRIP_H - 36 }, Size = { STRIP_W - 24, 24 } }
    end
  end

  return layout, graphics
end

function GetPins(props)
  local n = props["Channel Count"].Value
  local pins = {}
  for i = 1, n do table.insert(pins, { Name = string.format("In %d", i), Direction = "input" }) end
  for i = 1, n do table.insert(pins, { Name = string.format("Out %d", i), Direction = "output" }) end
  return pins
end

-- Embedded components become globals named after Name. An unknown Type is
-- dropped silently, so the runtime probes each one.
function GetComponents(props)
  local n = props["Channel Count"].Value
  local comps = {}
  table.insert(comps, { Name = "main_mixer", Type = "mixer", Properties = { ["n_inputs"] = n, ["n_outputs"] = n } })
  for i = 1, n do
    table.insert(comps, { Name = string.format("meter_%d", i), Type = "meter2", Properties = {} })
  end
  return comps
end

-- Each wire is a list of endpoints tied together: plugin pins by Name,
-- component pins as "<component> Input n" / "<component> Output n".
function GetWiring(props)
  local n = props["Channel Count"].Value
  local wiring = {}
  for i = 1, n do
    table.insert(wiring, { string.format("In %d", i), string.format("main_mixer Input %d", i) })
    table.insert(wiring, { string.format("main_mixer Output %d", i), string.format("Out %d", i), string.format("meter_%d Input 1", i) })
  end
  return wiring
end

-- ============================================================
-- Runtime
-- ============================================================
if Controls then
  print(string.format("%s %s %s – %s", BrandName, PluginInfo.Name, PluginInfo.Version, BrandSite))

  local n = Properties["Channel Count"].Value
  local function debugOn() return Properties["Debug"] and Properties["Debug"].Value end
  local function dbg(...) if debugOn() then print(...) end end

  Controls.Status.Value = 5   -- Initializing
  Controls.Status.String = "Starting"

  -- Count = 1 gives a single control object; normalise to array access.
  local function arr(c, count) return count == 1 and { c } or c end
  local Gain  = arr(Controls.Gain, n)
  local Mute  = arr(Controls.Mute, n)
  local Level = arr(Controls.Level, n)

  local mixer = _G["main_mixer"]
  local problems = {}
  if not mixer then table.insert(problems, "mixer engine missing") end

  -- Diagonal routing: input i -> output i at the channel gain, everything else off.
  local function apply(i)
    if not mixer then return end
    for o = 1, n do
      local db = (o == i and not Mute[i].Boolean) and Gain[i].Value or -100
      local ok = pcall(function() mixer[string.format("input.%d.output.%d.gain", i, o)].Value = db end)
      if not ok then dbg("crosspoint missing", i, o) end
    end
  end

  for i = 1, n do
    Gain[i].EventHandler = function() apply(i) end
    Mute[i].EventHandler = function() apply(i) end
    apply(i)
  end

  -- Meter polling: one timer for all channels.
  local meters = {}
  for i = 1, n do
    local comp = _G[string.format("meter_%d", i)]
    if comp then table.insert(meters, { comp = comp, ui = Level[i] }) end
  end
  if #meters < n then table.insert(problems, string.format("%d of %d meter engines missing", n - #meters, n)) end
  if #meters > 0 then
    local function tick()
      for _, m in ipairs(meters) do
        pcall(function() m.ui.Value = m.comp["meter.1"].Value end)
      end
      Timer.CallAfter(tick, 0.066)
    end
    Timer.CallAfter(tick, 0.066)
  end

  if #problems == 0 then
    Controls.Status.Value = 0
    Controls.Status.String = "OK"
  else
    Controls.Status.Value = 1   -- Compromised
    Controls.Status.String = table.concat(problems, "; ")
  end
  dbg("engines:", Controls.Status.String)
end
