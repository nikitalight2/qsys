-- ============================================================
--  Bettear CASTER – bettear.com
--  Q-SYS control plugin for the Bettear CASTER Auracast streamer
--
--  Talks to one or more CASTER units over the CASTER UDP API
--  (protocol reference v1.03, firmware 1.4.3 and above):
--    * one UDP socket on the Core, bound to the controller port
--      (9000 by default), shared by every device of this instance
--    * every command is "Device#<id> <command>\n"; the device first
--      answers OK (or ERR ...), then the in-context response
--    * a poll timer sends PING plus a GET of every field, so the
--      panel always mirrors the unit and the Status LED follows it
--
--  Product page:  https://bettear.com/products/caster
-- ============================================================

PluginInfo = {
  Name = "Bettear~CASTER",
  Version = "1.0.2",
  BuildVersion = "1.0.2.0",
  Id = "991bfdba-8a38-4556-a4f5-6b9d6dd64246",
  Author = "Bettear – bettear.com",
  Description = "Control for the Bettear CASTER Auracast streamer over its UDP API (v1.03, FW 1.4.3+): broadcast, encryption, audio input, RF, LEDs, network and timecode. bettear.com",
  ShowDebug = false,
}

-- ---------- Brand ----------
BrandName = "Bettear"
BrandSite = "bettear.com"
ProductName = "CASTER"

-- Colours: a neutral dark panel with a light header band so the
-- Bettear word mark (black on transparent) shows as supplied.
Brand = {
  Header    = { 250, 250, 250 },  -- #FAFAFA  light header band behind the logo
  HeaderTxt = {  20,  20,  20 },  -- #141414
  BG        = {  24,  26,  30 },  -- #181A1E
  Panel     = {  34,  37,  43 },  -- #22252B
  Stroke    = {  58,  62,  70 },  -- #3A3E46
  Text      = { 242, 243, 245 },  -- #F2F3F5
  Muted     = { 160, 166, 178 },  -- #A0A6B2
  Accent    = {   0, 160, 227 },  -- #00A0E3  primary control colour
  Accent2   = {  36, 196, 160 },  -- #24C4A0  secondary (audio)
  Warn      = { 240, 160,  32 },  -- #F0A020  reboot-required, raw command
  Danger    = { 224,  64,  80 },  -- #E04050  mute / reboot
  OK        = {  46, 204, 143 },  -- #2ECC8F
}

BrandAssets = {
  -- Bettear word mark, 300x147 PNG (base64), rasterised from the
  -- SVG in assets/brand/bettear-logo.svg
  Logo = "",
}

-- ============================================================
-- Protocol tables (shared by design time and runtime)
-- ============================================================
DEFAULT_PORT = 9000
DEFAULT_DEVICE_ID = 255

-- Enumerated fields: API token, index, and the label shown in the
-- combo box. The token is what goes on the wire.
ENUMS = {
  preset  = { { "LOW",  "LOW – 16 kHz" }, { "MED", "MED – 24 kHz" }, { "HIGH", "HIGH – 48 kHz" } },
  btype   = { { "STEREO", "STEREO" }, { "DUALMONO", "DUALMONO" } },
  lpf     = { { "NONE", "NONE" }, { "LPF8K", "LPF 8 kHz" }, { "LPF12K", "LPF 12 kHz" } },
  hpf     = { { "NONE", "NONE" }, { "HPF80", "HPF 80 Hz" }, { "HPF130", "HPF 130 Hz" }, { "HPF250", "HPF 250 Hz" } },
  antenna = { { "INTERNAL", "INTERNAL" }, { "EXTERNAL", "EXTERNAL" } },
  leds    = { { "NORMAL", "NORMAL" }, { "OFF", "OFF" }, { "AUDIO_INDICATOR", "AUDIO INDICATOR" } },
}

function EnumChoices(name)
  local t = {}
  for _, e in ipairs(ENUMS[name]) do table.insert(t, e[2]) end
  return t
end

-- Label -> token (what the device wants)
function EnumToken(name, label)
  for _, e in ipairs(ENUMS[name]) do
    if e[2] == label or e[1] == label then return e[1] end
  end
  return nil
end

-- Token or numeric index (as returned by the device) -> label
function EnumLabel(name, value)
  if value == nil then return nil end
  local n = tonumber(value)
  if n then
    local e = ENUMS[name][math.floor(n) + 1]
    return e and e[2] or nil
  end
  value = tostring(value):upper()
  for _, e in ipairs(ENUMS[name]) do
    if e[1] == value then return e[2] end
  end
  return nil
end

-- ============================================================
-- Design time
-- ============================================================
function GetColor(props) return Brand.BG end

function GetPrettyName(props)
  local n = props["Device Count"].Value
  if n == 1 then return BrandName .. " " .. ProductName end
  return string.format("%s %s (%d devices)", BrandName, ProductName, n)
end

function GetProperties()
  return {
    { Name = "Device Count", Type = "integer", Min = 1, Max = 16, Value = 1 },
    { Name = "Poll Interval (s)", Type = "integer", Min = 1, Max = 120, Value = 5 },
    { Name = "Local UDP Port", Type = "integer", Min = 1, Max = 65535, Value = DEFAULT_PORT },
    -- "Any" listens on every Core interface. Pick one when the Core has
    -- several networks and the units (or the multicast group) live on one of them.
    { Name = "Network Interface", Type = "enum", Choices = { "Any", "LAN A", "LAN B", "AUX A", "AUX B" }, Value = "Any" },
    { Name = "Debug", Type = "boolean", Value = false },
  }
end

function RectifyProperties(props)
  return props
end

-- One page per device, then a Setup page.
function GetPages(props)
  local pages = {}
  local n = props["Device Count"].Value
  if n == 1 then
    table.insert(pages, { name = "CASTER" })
  else
    for d = 1, n do table.insert(pages, { name = string.format("Device %d", d) }) end
  end
  table.insert(pages, { name = "Setup" })
  return pages
end

-- Every per-device control is declared with Count = device count, so
-- Controls.<Name>[d] (or the bare control when the count is 1) belongs
-- to device d.
function GetControls(props)
  local n = props["Device Count"].Value
  local c = {}
  local function add(t) t.Count = t.Count or n; table.insert(c, t) end

  -- Connection
  add({ Name = "IPAddress", ControlType = "Text", PinStyle = "Both", UserPin = true })
  add({ Name = "Port", ControlType = "Text" })
  add({ Name = "DeviceID", ControlType = "Text" })
  add({ Name = "Status", ControlType = "Indicator", IndicatorType = "Status", PinStyle = "Output" })
  add({ Name = "Online", ControlType = "Indicator", IndicatorType = "Led", PinStyle = "Output", UserPin = true })
  add({ Name = "Firmware", ControlType = "Indicator", IndicatorType = "Text", PinStyle = "Output" })
  add({ Name = "RebootRequired", ControlType = "Indicator", IndicatorType = "Led", PinStyle = "Output", UserPin = true })
  add({ Name = "Reboot", ControlType = "Button", ButtonType = "Trigger", PinStyle = "Input", UserPin = true })
  add({ Name = "Refresh", ControlType = "Button", ButtonType = "Trigger", PinStyle = "Input", UserPin = true })
  add({ Name = "Identify", ControlType = "Button", ButtonType = "Toggle", PinStyle = "Both", UserPin = true })

  -- Broadcast
  add({ Name = "BroadcastEnabled", ControlType = "Button", ButtonType = "Toggle", PinStyle = "Both", UserPin = true })
  add({ Name = "BroadcastName", ControlType = "Text", PinStyle = "Both", UserPin = true })
  add({ Name = "BroadcastPreset", ControlType = "Text", PinStyle = "Both", UserPin = true })
  add({ Name = "BroadcastType", ControlType = "Text", PinStyle = "Both", UserPin = true })
  add({ Name = "ProgramInfo1", ControlType = "Text", PinStyle = "Both", UserPin = true })
  add({ Name = "ProgramInfo2", ControlType = "Text", PinStyle = "Both", UserPin = true })
  add({ Name = "EncryptionEnabled", ControlType = "Button", ButtonType = "Toggle", PinStyle = "Both", UserPin = true })
  add({ Name = "EncryptionKey", ControlType = "Text", PinStyle = "Both", UserPin = true })

  -- Audio input & processing. Gain: API 0..88 in 0.5 dB steps = -12..+32 dB.
  add({ Name = "InputGain1", ControlType = "Knob", ControlUnit = "dB", Min = -12, Max = 32, DefaultValue = 0, PinStyle = "Both", UserPin = true })
  add({ Name = "InputGain2", ControlType = "Knob", ControlUnit = "dB", Min = -12, Max = 32, DefaultValue = 0, PinStyle = "Both", UserPin = true })
  add({ Name = "InputMute1", ControlType = "Button", ButtonType = "Toggle", PinStyle = "Both", UserPin = true })
  add({ Name = "InputMute2", ControlType = "Button", ButtonType = "Toggle", PinStyle = "Both", UserPin = true })
  add({ Name = "InputLink", ControlType = "Button", ButtonType = "Toggle", PinStyle = "Both", UserPin = true })
  add({ Name = "MonoMix", ControlType = "Button", ButtonType = "Toggle", PinStyle = "Both", UserPin = true })
  add({ Name = "AGC", ControlType = "Button", ButtonType = "Toggle", PinStyle = "Both", UserPin = true })
  add({ Name = "LPF", ControlType = "Text", PinStyle = "Both", UserPin = true })
  add({ Name = "HPF1", ControlType = "Text", PinStyle = "Both", UserPin = true })
  add({ Name = "HPF2", ControlType = "Text", PinStyle = "Both", UserPin = true })

  -- RF & antenna
  add({ Name = "TXPower", ControlType = "Knob", ControlUnit = "Percent", Min = 0, Max = 100, DefaultValue = 100, PinStyle = "Both", UserPin = true })
  add({ Name = "Antenna", ControlType = "Text", PinStyle = "Both", UserPin = true })

  -- Indicators
  add({ Name = "LEDMode", ControlType = "Text", PinStyle = "Both", UserPin = true })

  -- Network (static IP). Applied only by the APPLY button.
  add({ Name = "StaticIPEnabled", ControlType = "Button", ButtonType = "Toggle", PinStyle = "Both", UserPin = true })
  add({ Name = "StaticIP", ControlType = "Text" })
  add({ Name = "StaticMask", ControlType = "Text" })
  add({ Name = "StaticGateway", ControlType = "Text" })
  add({ Name = "ApplyStaticIP", ControlType = "Button", ButtonType = "Trigger" })

  -- Timecode
  add({ Name = "TimecodeEnabled", ControlType = "Button", ButtonType = "Toggle", PinStyle = "Both", UserPin = true })
  add({ Name = "TimecodeID", ControlType = "Text", PinStyle = "Both", UserPin = true })
  add({ Name = "TimecodePlay", ControlType = "Button", ButtonType = "Toggle", PinStyle = "Both", UserPin = true })
  add({ Name = "TimecodeTimestamp", ControlType = "Text", PinStyle = "Both", UserPin = true })
  add({ Name = "TimecodeOffset", ControlType = "Text", PinStyle = "Both", UserPin = true })
  add({ Name = "SendTimecode", ControlType = "Button", ButtonType = "Trigger", PinStyle = "Input", UserPin = true })

  -- Raw command (anything after "Device#<id> "), last reply, log
  add({ Name = "RawCommand", ControlType = "Text", PinStyle = "Input", UserPin = true })
  add({ Name = "SendRaw", ControlType = "Button", ButtonType = "Trigger" })
  add({ Name = "LastResponse", ControlType = "Indicator", IndicatorType = "Text", PinStyle = "Output" })
  add({ Name = "LastError", ControlType = "Indicator", IndicatorType = "Text", PinStyle = "Output" })
  add({ Name = "Log", ControlType = "Indicator", IndicatorType = "Text" })

  return c
end

-- ---------- Layout ----------
function GetControlLayout(props)
  local n = props["Device Count"].Value
  local pageIndex = props["page_index"].Value
  local pageCount = n + 1
  local isSetup = (pageIndex == pageCount)
  local d = isSetup and 1 or pageIndex

  local layout, graphics = {}, {}

  local HEADER, M, GAP, G = 56, 16, 12, 8
  local W = 740
  local PW = W - 2 * M            -- full-width panel (708)
  local HALF = (PW - GAP) / 2     -- two-column panel (348)
  local THIRD = (PW - 2 * GAP) / 3 -- three-column panel (228)

  -- idx() follows curDev so the Setup page can place per-device controls for every unit
  local curDev = d
  local function idx(name) return name .. (n == 1 and "" or (" " .. curDev)) end

  local function panel(x, y, w, h, titleText)
    table.insert(graphics, { Type = "GroupBox", Fill = Brand.Panel, StrokeColor = Brand.Stroke, StrokeWidth = 1, CornerRadius = 4, Position = { x, y }, Size = { w, h } })
    table.insert(graphics, { Type = "GroupBox", Fill = Brand.Accent, StrokeWidth = 0, CornerRadius = 0, Position = { x + 1, y + 1 }, Size = { w - 2, 2 } })
    if titleText then
      table.insert(graphics, { Type = "Label", Text = titleText, FontSize = 10, FontStyle = "Bold", HTextAlign = "Left", Color = Brand.Muted, Position = { x + G, y + 6 }, Size = { w - 2 * G, 12 } })
    end
  end
  local function caption(text, x, y, w, align)
    table.insert(graphics, { Type = "Label", Text = text, FontSize = 8, FontStyle = "Bold", HTextAlign = align or "Left", Color = Brand.Muted, Position = { x, y }, Size = { w, 10 } })
  end
  local function note(text, x, y, w, h)
    table.insert(graphics, { Type = "Label", Text = text, FontSize = 9, HTextAlign = "Left", VTextAlign = "Top", Color = Brand.Muted, Position = { x, y }, Size = { w, h or 12 } })
  end
  -- caption + text box; ry is the caption row (control sits 12 px below)
  local function field(name, label, x, ry, w, readOnly)
    caption(label, x, ry, w)
    layout[idx(name)] = { Style = "Text", HTextAlign = "Left", FontSize = 10, IsReadOnly = readOnly or false, Position = { x, ry + 12 }, Size = { w, 22 } }
  end
  local function combo(name, label, x, ry, w)
    caption(label, x, ry, w)
    layout[idx(name)] = { Style = "ComboBox", FontSize = 10, Position = { x, ry + 12 }, Size = { w, 22 } }
  end
  local function toggle(name, legend, x, y, w, color, h)
    layout[idx(name)] = { Style = "Button", ButtonStyle = "Toggle", Legend = legend, Color = color or Brand.Accent, UnlinkOffColor = true, OffColor = Brand.BG, FontSize = 10, CornerRadius = 4, Position = { x, y }, Size = { w, h or 22 } }
  end
  local function trigger(name, legend, x, y, w, color, h)
    layout[idx(name)] = { Style = "Button", ButtonStyle = "Trigger", Legend = legend, Color = color or Brand.Accent, FontSize = 10, CornerRadius = 4, Position = { x, y }, Size = { w, h or 22 } }
  end
  local function led(name, label, x, ry, color)
    caption(label, x, ry, 60)
    layout[idx(name)] = { Style = "Led", Color = color or Brand.OK, Position = { x, ry + 14 }, Size = { 18, 18 } }
  end
  local function knob(name, label, x, ry, size, color)
    caption(label, x, ry, size + 8)
    layout[idx(name)] = { Style = "Knob", Color = color or Brand.Accent, Position = { x, ry + 12 }, Size = { size, size } }
  end

  -- Page heights
  local devH = 60 + 92 + GAP + 176 + GAP + 140 + M
  local DEV_BLOCK = (n > 1 and 18 or 0) + 116 + GAP + 150 + GAP
  local setupH = HEADER + GAP + n * DEV_BLOCK - GAP + M
  local H = isSetup and setupH or devH

  -- Background + header band with the Bettear word mark (as supplied,
  -- black on a light band), the website, and the plugin name.
  table.insert(graphics, { Type = "GroupBox", Fill = Brand.BG, StrokeWidth = 0, Position = { 0, 0 }, Size = { W, H } })
  table.insert(graphics, { Type = "GroupBox", Fill = Brand.Header, StrokeWidth = 0, CornerRadius = 0, Position = { 0, 0 }, Size = { W, HEADER } })
  table.insert(graphics, { Type = "Image", Image = BrandAssets.Logo, Position = { M, 4 }, Size = { 98, 48 } })
  table.insert(graphics, { Type = "Label", Text = BrandSite, FontSize = 9, HTextAlign = "Left", Color = Brand.HeaderTxt, Position = { M + 106, 36 }, Size = { 120, 14 } })
  table.insert(graphics, { Type = "Label", Text = GetPrettyName(props) .. (isSetup and " – Setup" or (n > 1 and string.format(" – Device %d", d) or "")), FontSize = 13, FontStyle = "Bold", HTextAlign = "Right", Color = Brand.HeaderTxt, Position = { W - 320 - M - 26, 18 }, Size = { 320, 20 } })
  table.insert(graphics, { Type = "GroupBox", Fill = Brand.Accent, StrokeWidth = 0, CornerRadius = 0, Position = { 0, HEADER - 3 }, Size = { W, 3 } })

  if not isSetup then
    layout[idx("Status")] = { Style = "Led", Position = { W - M - 18, 19 }, Size = { 18, 18 } }

    -- Row 1: device / connection
    local y = HEADER + GAP
    local x = M
    panel(x, y, PW, 92, "DEVICE")
    local ry = y + 22
    field("IPAddress", "IP ADDRESS", x + G, ry, 130)
    field("Port", "PORT", x + 146, ry, 56)
    field("DeviceID", "DEVICE ID", x + 210, ry, 60)
    field("Firmware", "FIRMWARE", x + 278, ry, 104, true)
    led("Online", "ONLINE", x + 392, ry, Brand.OK)
    led("RebootRequired", "REBOOT REQ", x + 446, ry, Brand.Warn)
    trigger("Refresh", "REFRESH", x + 514, ry + 12, 58)
    toggle("Identify", "IDENTIFY", x + 580, ry + 12, 58, Brand.Accent2)
    trigger("Reboot", "REBOOT", x + 646, ry + 12, 54, Brand.Danger)
    note("Device ID 0 is the wildcard for a multicast IP address. REBOOT REQ lit: reboot the unit to apply the flagged settings.", x + G, y + 72, PW - 2 * G)

    -- Row 2: broadcast (left) + audio input (right)
    y = y + 92 + GAP
    panel(x, y, HALF, 176, "BROADCAST")
    ry = y + 22
    caption("ACTIVITY", x + G, ry, 100)
    toggle("BroadcastEnabled", "ENABLED", x + G, ry + 12, 100, Brand.Accent)
    field("BroadcastName", "ADVERTISED NAME", x + 116, ry, HALF - 116 - G)
    ry = y + 58
    combo("BroadcastPreset", "PRESET (SAMPLE RATE)", x + G, ry, 162)
    combo("BroadcastType", "TYPE", x + 178, ry, HALF - 178 - G)
    ry = y + 94
    field("ProgramInfo1", "DUAL MONO INFO CH 1", x + G, ry, 162)
    field("ProgramInfo2", "DUAL MONO INFO CH 2", x + 178, ry, HALF - 178 - G)
    ry = y + 130
    caption("ENCRYPTION", x + G, ry, 100)
    toggle("EncryptionEnabled", "ENCRYPTED", x + G, ry + 12, 100, Brand.Accent)
    field("EncryptionKey", "BROADCAST KEY (MAX 16 CHARS)", x + 116, ry, HALF - 116 - G)

    local ax = x + HALF + GAP
    panel(ax, y, HALF, 176, "AUDIO INPUT")
    for ch = 1, 2 do
      ry = y + 22 + (ch - 1) * 48
      knob("InputGain" .. ch, "GAIN " .. ch, ax + G, ry, 36, Brand.Accent2)
      caption("MUTE " .. ch, ax + 60, ry, 52)
      toggle("InputMute" .. ch, "MUTE", ax + 60, ry + 12, 52, Brand.Danger)
      combo("HPF" .. ch, "HIGH-PASS " .. ch, ax + 120, ry, 110)
    end
    ry = y + 118
    caption("LINK L/R", ax + G, ry, 60)
    toggle("InputLink", "LINK", ax + G, ry + 12, 60, Brand.Accent2)
    caption("MONO MIX", ax + 76, ry, 70)
    toggle("MonoMix", "MONO", ax + 76, ry + 12, 70, Brand.Accent2)
    caption("AGC", ax + 154, ry, 50)
    toggle("AGC", "AGC", ax + 154, ry + 12, 50, Brand.Accent2)
    combo("LPF", "LOW-PASS (GLOBAL)", ax + 212, ry, HALF - 212 - G)
    note("Gain -12 to +32 dB", ax + 238, y + 34, 102)
    note("in 0.5 dB steps", ax + 238, y + 46, 102)

    -- Row 3: RF, LEDs, timecode
    y = y + 176 + GAP
    panel(x, y, THIRD, 140, "RF & ANTENNA")
    ry = y + 22
    knob("TXPower", "TX POWER", x + G, ry, 40, Brand.Accent)
    combo("Antenna", "ANTENNA", x + 64, ry, THIRD - 64 - G)
    note("0 % = -10 dB, 100 % = maximum", x + G, y + 84, THIRD - 2 * G)
    note("(+10 or +20 dB, model dependent)", x + G, y + 98, THIRD - 2 * G)

    local lx = x + THIRD + GAP
    panel(lx, y, THIRD, 140, "LEDS")
    combo("LEDMode", "LED MODE", lx + G, ry, THIRD - 2 * G)
    note("IDENTIFY (top row) blinks the LEDs", lx + G, y + 64, THIRD - 2 * G)
    note("so the unit can be found in a rack.", lx + G, y + 78, THIRD - 2 * G)

    local tx = lx + THIRD + GAP
    panel(tx, y, THIRD, 140, "TIMECODE")
    caption("MODE", tx + G, ry, 70)
    toggle("TimecodeEnabled", "ENABLED", tx + G, ry + 12, 70, Brand.Accent)
    field("TimecodeID", "ID (0-99)", tx + 86, ry, 54)
    caption("STATE", tx + 148, ry, 72)
    toggle("TimecodePlay", "PLAY", tx + 148, ry + 12, THIRD - 148 - G, Brand.Accent2)
    ry = y + 58
    field("TimecodeTimestamp", "TIMESTAMP (MS)", tx + G, ry, 100)
    field("TimecodeOffset", "OFFSET (± MS)", tx + 116, ry, THIRD - 116 - G)
    trigger("SendTimecode", "SEND TIMECODE", tx + G, y + 106, THIRD - 2 * G)

  else
    -- Setup page: static IP, raw command and replies/log, one block per unit
    local y = HEADER + GAP
    local x = M
    for dev = 1, n do
      curDev = dev
      if n > 1 then
        table.insert(graphics, { Type = "Label", Text = string.format("DEVICE %d", dev), FontSize = 10, FontStyle = "Bold", HTextAlign = "Left", Color = Brand.Accent, Position = { x, y + 2 }, Size = { PW, 12 } })
        y = y + 18
      end
      local ry
    panel(x, y, HALF, 116, "NETWORK (STATIC IP)")
    ry = y + 22
    caption("MODE", x + G, ry, 90)
    toggle("StaticIPEnabled", "STATIC IP", x + G, ry + 12, 90, Brand.Accent)
    field("StaticIP", "IP ADDRESS", x + 106, ry, 110)
    field("StaticMask", "SUBNET MASK", x + 224, ry, HALF - 224 - G)
    ry = y + 58
    field("StaticGateway", "GATEWAY", x + G, ry, 110)
    trigger("ApplyStaticIP", "APPLY CONFIG", x + 126, ry + 12, 100, Brand.Warn)
    note("APPLY sends address, mask and gateway at once. Reboot required.", x + G, y + 96, HALF - 2 * G)

    local rx = x + HALF + GAP
    panel(rx, y, HALF, 116, "RAW COMMAND")
    ry = y + 22
    field("RawCommand", "COMMAND (WITHOUT THE Device#<id> PREFIX)", rx + G, ry, HALF - 2 * G - 70)
    trigger("SendRaw", "SEND", rx + HALF - G - 62, ry + 12, 62, Brand.Warn)
    note("e.g.  GET version   or   SET leds.mode OFF", rx + G, ry + 40, HALF - 2 * G)
    note("Press Enter in the box or click SEND.", rx + G, ry + 54, HALF - 2 * G)

    y = y + 116 + GAP
    panel(x, y, PW, 150, "REPLIES")
    ry = y + 22
    field("LastResponse", "LAST REPLY", x + G, ry, HALF - G)
    field("LastError", "LAST ERROR", x + HALF + GAP, ry, HALF - G, true)
    caption("LOG (NEWEST LAST)", x + G, y + 60, 200)
    layout[idx("Log")] = { Style = "Text", HTextAlign = "Left", VTextAlign = "Top", FontSize = 8, IsReadOnly = true, WordWrap = true, Position = { x + G, y + 72 }, Size = { PW - 2 * G, 150 - 72 - G } }
      y = y + 150 + GAP
    end
    curDev = d
  end

  return layout, graphics
end

-- No audio pins, no embedded components: this is a pure control plugin.
function GetPins(props) return {} end
function GetComponents(props) return {} end
function GetWiring(props) return {} end

-- ============================================================
-- Runtime
-- ============================================================
if Controls then
  print(string.format("%s %s plugin %s – %s", BrandName, ProductName, PluginInfo.Version, BrandSite))

  local N = Properties["Device Count"].Value
  local POLL = Properties["Poll Interval (s)"].Value
  local LOCAL_PORT = Properties["Local UDP Port"].Value
  local IFACE = (Properties["Network Interface"] and Properties["Network Interface"].Value) or "Any"
  local OFFLINE_AFTER = 3        -- missed polls before a unit is Missing
  local TX_GAP = 0.03            -- seconds between queued datagrams
  local KNOB_SETTLE = 0.15       -- seconds a knob must rest before SET
  local LOG_LINES = 40

  local function debugOn() return Properties["Debug"] and Properties["Debug"].Value end
  local function dbg(...) if debugOn() then print(...) end end

  -- A control declared with Count = 1 arrives as a single object, not a
  -- one-element array. arr() normalises both shapes.
  local function arr(c) return N == 1 and { c } or c end
  local C = {}
  for _, name in ipairs({
    "IPAddress", "Port", "DeviceID", "Status", "Online", "Firmware", "RebootRequired", "Reboot", "Refresh", "Identify",
    "BroadcastEnabled", "BroadcastName", "BroadcastPreset", "BroadcastType", "ProgramInfo1", "ProgramInfo2", "EncryptionEnabled", "EncryptionKey",
    "InputGain1", "InputGain2", "InputMute1", "InputMute2", "InputLink", "MonoMix", "AGC", "LPF", "HPF1", "HPF2",
    "TXPower", "Antenna", "LEDMode",
    "StaticIPEnabled", "StaticIP", "StaticMask", "StaticGateway", "ApplyStaticIP",
    "TimecodeEnabled", "TimecodeID", "TimecodePlay", "TimecodeTimestamp", "TimecodeOffset", "SendTimecode",
    "RawCommand", "SendRaw", "LastResponse", "LastError", "Log",
  }) do
    C[name] = arr(Controls[name])
  end

  -- ---------- helpers ----------
  local function trim(s) return (tostring(s or ""):gsub("^%s+", ""):gsub("%s+$", "")) end
  local function clamp(v, lo, hi) if v < lo then return lo elseif v > hi then return hi end return v end
  local function round(v) return math.floor(v + 0.5) end
  local function boolArg(b) return b and "1" or "0" end
  local function parseBool(s)
    s = tostring(s or ""):upper()
    return s == "1" or s == "TRUE" or s == "ON"
  end
  local function quoteIfNeeded(s)
    s = trim(s):gsub('"', "")
    if s:find("%s") then return '"' .. s .. '"' end
    return s
  end
  local function unquote(s)
    s = trim(s)
    if #s >= 2 and s:sub(1, 1) == '"' and s:sub(-1) == '"' then s = s:sub(2, -2) end
    return s
  end
  local function isMulticast(ip)
    local a = tonumber(ip:match("^(%d+)%."))
    return a ~= nil and a >= 224 and a <= 239
  end

  local function deviceIP(d) return trim(C.IPAddress[d].String) end
  local function devicePort(d)
    local p = tonumber(trim(C.Port[d].String))
    if not p or p < 1 or p > 65535 then return DEFAULT_PORT end
    return math.floor(p)
  end
  local function deviceID(d)
    local id = tonumber(trim(C.DeviceID[d].String))
    if not id then return DEFAULT_DEVICE_ID end
    return math.floor(clamp(id, 0, 255))
  end

  -- ---------- per-device state ----------
  local missed, online, rebooting, logLines = {}, {}, {}, {}
  for d = 1, N do missed[d] = 0; online[d] = false; rebooting[d] = false; logLines[d] = {} end

  local function log(d, line)
    local t = logLines[d]
    table.insert(t, line)
    while #t > LOG_LINES do table.remove(t, 1) end
    C.Log[d].String = table.concat(t, "\n")
    dbg(string.format("[%d] %s", d, line))
  end

  local function setStatus(d, value, text)
    C.Status[d].Value = value
    C.Status[d].String = text
  end

  local function refreshStatus(d)
    if deviceIP(d) == "" then
      setStatus(d, 3, "No IP address set")
    elseif not online[d] then
      if rebooting[d] and missed[d] < OFFLINE_AFTER * 4 then
        setStatus(d, 5, "Rebooting, waiting for the unit to answer")
      else
        setStatus(d, 4, string.format("No reply from %s:%d", deviceIP(d), devicePort(d)))
      end
    elseif C.RebootRequired[d].Boolean then
      setStatus(d, 1, "Reboot required to apply changes")
    else
      local fw = trim(C.Firmware[d].String)
      setStatus(d, 0, fw ~= "" and ("Online, firmware " .. fw) or "Online")
    end
    C.Online[d].Boolean = online[d]
  end

  -- ---------- UDP socket + send queue ----------
  local sock = UdpSocket.New()
  local txQueue, txTimer, txRunning = {}, Timer.New(), false

  local function pump()
    local item = table.remove(txQueue, 1)
    if item then
      local ok, err = pcall(function() sock:Send(item.ip, item.port, item.line .. "\n") end)
      if not ok then log(item.d, "send failed: " .. tostring(err)) end
    end
    if #txQueue == 0 then txTimer:Stop(); txRunning = false end
  end
  txTimer.EventHandler = pump

  local function send(d, body)
    local ip = deviceIP(d)
    if ip == "" then return end
    local line = string.format("Device#%d %s", deviceID(d), body)
    table.insert(txQueue, { d = d, ip = ip, port = devicePort(d), line = line })
    log(d, "> " .. line)
    if not txRunning then txRunning = true; txTimer:Start(TX_GAP) end
  end

  local function openSocket()
    -- The unit replies to port 9000 on the sender, so the Core must own
    -- that port. Try the bind forms in order; the last resort is an
    -- ephemeral port, which only works if the unit answers the source port.
    local attempts = {}
    local function anyInterface()
      table.insert(attempts, { desc = string.format("all interfaces, port %d", LOCAL_PORT), fn = function() sock:Open(nil, LOCAL_PORT) end })
      table.insert(attempts, { desc = string.format("all interfaces (0.0.0.0), port %d", LOCAL_PORT), fn = function() sock:Open("0.0.0.0", LOCAL_PORT) end })
      table.insert(attempts, { desc = string.format("all interfaces (empty address), port %d", LOCAL_PORT), fn = function() sock:Open("", LOCAL_PORT) end })
    end
    local ifaces = {}
    if type(Network) == "table" and type(Network.Interfaces) == "function" then
      local okI, list = pcall(Network.Interfaces)
      if okI and type(list) == "table" then
        for _, i in ipairs(list) do
          if type(i) == "table" and i.Address and i.Address ~= "" then table.insert(ifaces, i) end
        end
      end
    end
    local function addInterface(i)
      local addr = i.Address
      table.insert(attempts, { desc = string.format("%s (%s), port %d", tostring(i.Interface or "interface"), addr, LOCAL_PORT), fn = function() sock:Open(addr, LOCAL_PORT) end })
    end
    if IFACE == "Any" then
      anyInterface()
      for _, i in ipairs(ifaces) do addInterface(i) end
    else
      -- the chosen interface first; the others only as a fallback
      local found = false
      for _, i in ipairs(ifaces) do
        if tostring(i.Interface or ""):upper() == IFACE:upper() then addInterface(i); found = true end
      end
      if not found then
        print(string.format("%s %s: interface %s not found on this Core, falling back", BrandName, ProductName, IFACE))
      end
      anyInterface()
      for _, i in ipairs(ifaces) do
        if tostring(i.Interface or ""):upper() ~= IFACE:upper() then addInterface(i) end
      end
    end
    table.insert(attempts, { desc = "ephemeral port (replies to port " .. LOCAL_PORT .. " will not arrive)", fn = function() sock:Open() end })
    local errors = {}
    for _, a in ipairs(attempts) do
      local ok, err = pcall(a.fn)
      if ok then
        print(string.format("%s %s: UDP socket open on %s", BrandName, ProductName, a.desc))
        return true
      end
      table.insert(errors, tostring(err))
    end
    print(string.format("%s %s: could not open the UDP socket: %s", BrandName, ProductName, table.concat(errors, " | ")))
    return false
  end

  -- ---------- outgoing commands ----------
  local function gainToApi(db) return math.floor(clamp(round((db + 12) * 2), 0, 88)) end
  local function apiToGain(n) return clamp(tonumber(n) or 24, 0, 88) / 2 - 12 end

  local function sendBool(d, field, b) send(d, string.format("SET %s %s", field, boolArg(b))) end
  local function sendEnum(d, field, enum, label)
    local token = EnumToken(enum, label)
    if token then send(d, string.format("SET %s %s", field, token)) end
  end
  local function sendGain(d) send(d, string.format("SET input.gain %d %d", gainToApi(C.InputGain1[d].Value), gainToApi(C.InputGain2[d].Value))) end
  local function sendMute(d) send(d, string.format("SET input.mute %s %s", boolArg(C.InputMute1[d].Boolean), boolArg(C.InputMute2[d].Boolean))) end
  local function sendTXPower(d) send(d, string.format("SET tx_power_pct %d", math.floor(clamp(round(C.TXPower[d].Value), 0, 100)))) end

  local function timecodeID(d)
    local id = tonumber(trim(C.TimecodeID[d].String)) or 0
    return math.floor(clamp(id, 0, 99))
  end
  local function sendTimecode(d)
    local ts = tonumber(trim(C.TimecodeTimestamp[d].String)) or 0
    ts = math.floor(clamp(ts, 0, 4294967295))
    send(d, string.format("SET timecode %d %s %d", timecodeID(d), boolArg(C.TimecodePlay[d].Boolean), ts))
  end
  local function sendTimecodeOffset(d)
    local off = tonumber(trim(C.TimecodeOffset[d].String))
    if off == nil then return end
    send(d, string.format("SET timecode.offsets %d %d", timecodeID(d), math.floor(off)))
  end

  local function queryAll(d)
    for _, f in ipairs({
      "version", "broadcast.enabled", "broadcast.names.0", "broadcast.preset", "broadcast.type",
      "broadcast.dualmono.ch1.programInfo", "broadcast.dualmono.ch2.programInfo",
      "broadcast.encryption.enabled", "broadcast.encryption.key",
      "input.gain", "input.mute", "input.link", "input.mono_mix", "agc.enabled", "filters.lpf",
      "filters.hpf 0", "filters.hpf 1", "tx_power_pct", "antsel.ant_mode",
      "static_ip.enabled", "static_ip.config", "leds.mode", "leds.blink", "timecode.enabled",
    }) do
      send(d, "GET " .. f)
    end
    send(d, string.format("GET timecode %d", timecodeID(d)))
    send(d, string.format("GET timecode.offsets %d", timecodeID(d)))
  end

  -- Knob settle: coalesce a burst of knob events into one SET.
  local pendingKnob = {}
  local function settle(key, fn)
    pendingKnob[key] = fn
    Timer.CallAfter(function()
      local f = pendingKnob[key]
      if f == fn then pendingKnob[key] = nil; f() end
    end, KNOB_SETTLE)
  end

  -- ---------- incoming replies ----------
  local function setCombo(ctl, enum, value)
    local label = EnumLabel(enum, value)
    if label then ctl.String = label end
  end

  -- field name -> handler(d, args, rest) where args = whitespace tokens
  -- after the field name and rest = the raw remainder of the line.
  local fields = {}
  fields["version"] = function(d, a, rest) C.Firmware[d].String = rest end
  fields["broadcast.enabled"] = function(d, a) C.BroadcastEnabled[d].Boolean = parseBool(a[1]) end
  fields["broadcast.names.0"] = function(d, a, rest) C.BroadcastName[d].String = unquote(rest) end
  fields["broadcast.preset"] = function(d, a) setCombo(C.BroadcastPreset[d], "preset", a[1]) end
  fields["broadcast.type"] = function(d, a) setCombo(C.BroadcastType[d], "btype", a[1]) end
  fields["broadcast.dualmono.ch1.programInfo"] = function(d, a, rest) C.ProgramInfo1[d].String = unquote(rest) end
  fields["broadcast.dualmono.ch2.programInfo"] = function(d, a, rest) C.ProgramInfo2[d].String = unquote(rest) end
  fields["broadcast.encryption.enabled"] = function(d, a) C.EncryptionEnabled[d].Boolean = parseBool(a[1]) end
  fields["broadcast.encryption.key"] = function(d, a, rest) C.EncryptionKey[d].String = unquote(rest) end
  fields["input.gain"] = function(d, a)
    if a[1] then C.InputGain1[d].Value = apiToGain(a[1]) end
    if a[2] then C.InputGain2[d].Value = apiToGain(a[2]) end
  end
  fields["input.mute"] = function(d, a)
    if a[1] then C.InputMute1[d].Boolean = parseBool(a[1]) end
    if a[2] then C.InputMute2[d].Boolean = parseBool(a[2]) end
  end
  fields["input.link"] = function(d, a) C.InputLink[d].Boolean = parseBool(a[1]) end
  fields["input.mono_mix"] = function(d, a) C.MonoMix[d].Boolean = parseBool(a[1]) end
  fields["agc.enabled"] = function(d, a) C.AGC[d].Boolean = parseBool(a[1]) end
  fields["filters.lpf"] = function(d, a) setCombo(C.LPF[d], "lpf", a[1]) end
  fields["filters.hpf"] = function(d, a)
    local ch = tonumber(a[1])
    if ch == 0 then setCombo(C.HPF1[d], "hpf", a[2]) elseif ch == 1 then setCombo(C.HPF2[d], "hpf", a[2]) end
  end
  fields["tx_power_pct"] = function(d, a) local v = tonumber(a[1]); if v then C.TXPower[d].Value = clamp(v, 0, 100) end end
  fields["antsel.ant_mode"] = function(d, a) setCombo(C.Antenna[d], "antenna", a[1]) end
  fields["static_ip.enabled"] = function(d, a) C.StaticIPEnabled[d].Boolean = parseBool(a[1]) end
  fields["static_ip.config"] = function(d, a)
    C.StaticIP[d].String = a[1] or ""
    C.StaticMask[d].String = a[2] or ""
    C.StaticGateway[d].String = a[3] or ""
  end
  fields["leds.mode"] = function(d, a) setCombo(C.LEDMode[d], "leds", a[1]) end
  fields["leds.blink"] = function(d, a) C.Identify[d].Boolean = parseBool(a[1]) end
  fields["timecode.enabled"] = function(d, a) C.TimecodeEnabled[d].Boolean = parseBool(a[1]) end
  fields["timecode"] = function(d, a)
    -- only mirror the timecode slot the panel is looking at
    if tonumber(a[1]) ~= timecodeID(d) then return end
    local st = tostring(a[2] or ""):upper()
    C.TimecodePlay[d].Boolean = (st == "1" or st == "PLAY")
    if a[3] then C.TimecodeTimestamp[d].String = a[3] end
  end
  fields["timecode.offsets"] = function(d, a)
    if tonumber(a[1]) ~= timecodeID(d) then return end
    if a[2] then C.TimecodeOffset[d].String = a[2] end
  end
  fields["controller.id"] = function(d, a) if a[1] then C.DeviceID[d].String = a[1] end end
  fields["controller.port"] = function(d, a) end   -- shown in the log only

  local function handleLine(d, line)
    line = trim(line)
    if line == "" then return end
    log(d, "< " .. line)
    local id, body = line:match("^Device#(%d+)%s*(.*)$")
    body = body or line
    body = trim(body)
    local upper = body:upper()
    if upper == "OK" then
      return
    elseif upper == "PONG" then
      return
    elseif upper == "REBOOTING" then
      C.RebootRequired[d].Boolean = false
      C.LastResponse[d].String = body
      online[d] = false
      rebooting[d] = true
      missed[d] = 0
      return
    elseif upper == "REBOOT REQUIRED" then
      C.RebootRequired[d].Boolean = true
      refreshStatus(d)
      return
    elseif upper:sub(1, 3) == "ERR" then
      C.LastError[d].String = body
      C.LastResponse[d].String = body
      return
    end
    C.LastResponse[d].String = body
    local field, rest = body:match("^(%S+)%s*(.*)$")
    if not field then return end
    local args = {}
    for tok in rest:gmatch("%S+") do table.insert(args, tok) end
    local h = fields[field]
    if h then
      local ok, err = pcall(h, d, args, rest)
      if not ok then log(d, "parse error: " .. tostring(err)) end
    end
  end

  local function deviceForPacket(packet)
    -- Match the sender's IP first; when a device is addressed through a
    -- multicast group its replies come from its own IP, so fall back to
    -- the device ID in the reply, and finally to the only device there is.
    for d = 1, N do
      if deviceIP(d) == packet.Address then return d end
    end
    local id = tonumber(tostring(packet.Data):match("Device#(%d+)"))
    if id then
      local found
      for d = 1, N do
        if isMulticast(deviceIP(d)) and (deviceID(d) == id or deviceID(d) == 0) then
          if found then return nil end   -- ambiguous
          found = d
        end
      end
      if found then return found end
    end
    if N == 1 then return 1 end
    return nil
  end

  sock.EventHandler = function(s, packet)
    local d = deviceForPacket(packet)
    if not d then
      dbg("reply from unknown address " .. tostring(packet.Address) .. ": " .. tostring(packet.Data))
      return
    end
    local wasOnline = online[d]
    missed[d] = 0
    online[d] = true
    rebooting[d] = false
    for line in tostring(packet.Data):gmatch("[^\r\n]+") do handleLine(d, line) end
    if not wasOnline then
      refreshStatus(d)
      queryAll(d)
    else
      refreshStatus(d)
    end
  end

  -- ---------- polling ----------
  local pollTimer = Timer.New()
  pollTimer.EventHandler = function()
    for d = 1, N do
      if deviceIP(d) ~= "" then
        missed[d] = missed[d] + 1
        if missed[d] >= OFFLINE_AFTER and online[d] then
          online[d] = false
          refreshStatus(d)
        elseif missed[d] >= OFFLINE_AFTER then
          refreshStatus(d)
        end
        send(d, "PING")
        if online[d] then queryAll(d) end
      else
        online[d] = false
        refreshStatus(d)
      end
    end
  end

  local function restartDevice(d)
    missed[d] = 0
    online[d] = false
    rebooting[d] = false
    C.RebootRequired[d].Boolean = false
    C.Firmware[d].String = ""
    C.LastError[d].String = ""
    refreshStatus(d)
    if deviceIP(d) ~= "" then
      send(d, "PING")
      queryAll(d)
    end
  end

  -- ---------- event handlers ----------
  for d = 1, N do
    C.IPAddress[d].EventHandler = function() restartDevice(d) end
    C.Port[d].EventHandler = function()
      C.Port[d].String = tostring(devicePort(d))
      restartDevice(d)
    end
    C.DeviceID[d].EventHandler = function()
      C.DeviceID[d].String = tostring(deviceID(d))
      restartDevice(d)
    end
    C.Refresh[d].EventHandler = function() queryAll(d) end
    C.Reboot[d].EventHandler = function() send(d, "REBOOT") end
    C.Identify[d].EventHandler = function() sendBool(d, "leds.blink", C.Identify[d].Boolean) end

    C.BroadcastEnabled[d].EventHandler = function() sendBool(d, "broadcast.enabled", C.BroadcastEnabled[d].Boolean) end
    C.BroadcastName[d].EventHandler = function()
      local name = quoteIfNeeded(C.BroadcastName[d].String)
      if name ~= "" then send(d, "SET broadcast.names.0 " .. name) end
    end
    C.BroadcastPreset[d].EventHandler = function() sendEnum(d, "broadcast.preset", "preset", C.BroadcastPreset[d].String) end
    C.BroadcastType[d].EventHandler = function() sendEnum(d, "broadcast.type", "btype", C.BroadcastType[d].String) end
    C.ProgramInfo1[d].EventHandler = function()
      local v = quoteIfNeeded(C.ProgramInfo1[d].String)
      if v ~= "" then send(d, "SET broadcast.dualmono.ch1.programInfo " .. v) end
    end
    C.ProgramInfo2[d].EventHandler = function()
      local v = quoteIfNeeded(C.ProgramInfo2[d].String)
      if v ~= "" then send(d, "SET broadcast.dualmono.ch2.programInfo " .. v) end
    end
    C.EncryptionEnabled[d].EventHandler = function() sendBool(d, "broadcast.encryption.enabled", C.EncryptionEnabled[d].Boolean) end
    C.EncryptionKey[d].EventHandler = function()
      local key = trim(C.EncryptionKey[d].String):gsub("%s", "")
      if #key > 16 then key = key:sub(1, 16) end
      C.EncryptionKey[d].String = key
      if key ~= "" then send(d, "SET broadcast.encryption.key " .. key) end
    end

    C.InputGain1[d].EventHandler = function() settle("gain" .. d, function() sendGain(d) end) end
    C.InputGain2[d].EventHandler = function() settle("gain" .. d, function() sendGain(d) end) end
    C.InputMute1[d].EventHandler = function() sendMute(d) end
    C.InputMute2[d].EventHandler = function() sendMute(d) end
    C.InputLink[d].EventHandler = function() sendBool(d, "input.link", C.InputLink[d].Boolean) end
    C.MonoMix[d].EventHandler = function() sendBool(d, "input.mono_mix", C.MonoMix[d].Boolean) end
    C.AGC[d].EventHandler = function() sendBool(d, "agc.enabled", C.AGC[d].Boolean) end
    C.LPF[d].EventHandler = function() sendEnum(d, "filters.lpf", "lpf", C.LPF[d].String) end
    C.HPF1[d].EventHandler = function() sendEnum(d, "filters.hpf 0", "hpf", C.HPF1[d].String) end
    C.HPF2[d].EventHandler = function() sendEnum(d, "filters.hpf 1", "hpf", C.HPF2[d].String) end

    C.TXPower[d].EventHandler = function() settle("tx" .. d, function() sendTXPower(d) end) end
    C.Antenna[d].EventHandler = function() sendEnum(d, "antsel.ant_mode", "antenna", C.Antenna[d].String) end
    C.LEDMode[d].EventHandler = function() sendEnum(d, "leds.mode", "leds", C.LEDMode[d].String) end

    C.StaticIPEnabled[d].EventHandler = function() sendBool(d, "static_ip.enabled", C.StaticIPEnabled[d].Boolean) end
    C.ApplyStaticIP[d].EventHandler = function()
      local ip, mask, gw = trim(C.StaticIP[d].String), trim(C.StaticMask[d].String), trim(C.StaticGateway[d].String)
      if ip == "" or mask == "" or gw == "" then
        C.LastError[d].String = "Static IP: fill in address, mask and gateway first"
        return
      end
      send(d, string.format("SET static_ip.config %s %s %s", ip, mask, gw))
    end

    C.TimecodeEnabled[d].EventHandler = function() sendBool(d, "timecode.enabled", C.TimecodeEnabled[d].Boolean) end
    C.TimecodeID[d].EventHandler = function()
      C.TimecodeID[d].String = tostring(timecodeID(d))
      send(d, string.format("GET timecode %d", timecodeID(d)))
      send(d, string.format("GET timecode.offsets %d", timecodeID(d)))
    end
    C.TimecodePlay[d].EventHandler = function() sendTimecode(d) end
    C.TimecodeTimestamp[d].EventHandler = function() sendTimecode(d) end
    C.SendTimecode[d].EventHandler = function() sendTimecode(d) end
    C.TimecodeOffset[d].EventHandler = function() sendTimecodeOffset(d) end

    local function sendRaw()
      local cmd = trim(C.RawCommand[d].String)
      if cmd ~= "" then send(d, cmd) end
    end
    C.RawCommand[d].EventHandler = sendRaw
    C.SendRaw[d].EventHandler = sendRaw
  end

  -- ---------- init ----------
  local function init()
    for d = 1, N do
      C.BroadcastPreset[d].Choices = EnumChoices("preset")
      C.BroadcastType[d].Choices = EnumChoices("btype")
      C.LPF[d].Choices = EnumChoices("lpf")
      C.HPF1[d].Choices = EnumChoices("hpf")
      C.HPF2[d].Choices = EnumChoices("hpf")
      C.Antenna[d].Choices = EnumChoices("antenna")
      C.LEDMode[d].Choices = EnumChoices("leds")
      if trim(C.Port[d].String) == "" then C.Port[d].String = tostring(DEFAULT_PORT) end
      if trim(C.DeviceID[d].String) == "" then C.DeviceID[d].String = tostring(DEFAULT_DEVICE_ID) end
      if trim(C.TimecodeID[d].String) == "" then C.TimecodeID[d].String = "0" end
      C.RebootRequired[d].Boolean = false
      C.LastError[d].String = ""
      C.Log[d].String = ""
      setStatus(d, 5, "Initializing")
    end
    openSocket()
    for d = 1, N do restartDevice(d) end
    pollTimer:Start(POLL)
  end

  init()
end
