-- ============================================================
--  Nikita Visual Arts – nikitavisual.art
--  Color Picker (RGBW) for Q-SYS
--
--  A basic colour picker: a fixed palette of 16 swatches and a
--  brightness knob. The chosen colour comes out as four RGBW
--  values (Red / Green / Blue / White) on control pins, plus a
--  combined "R,G,B,W" string, ready to feed an LED controller.
--  Built from the Nikita Visual Arts Q-SYS Plugin Template.
-- ============================================================

PluginInfo = {
  Name = "Nikita Visual Arts~Color Picker RGBW",
  Version = "1.0.0",
  BuildVersion = "1.0.0.0",
  Id = "7c2a9d4e-5b31-4f8a-9e6d-2f1c8b7a3d55",
  Author = "Nikita Visual Arts – nikitavisual.art",
  Description = "Basic colour picker: 16 fixed swatches + brightness, output as RGBW values. Nikita Visual Arts – nikitavisual.art",
  ShowDebug = false,
}

-- ---------- Brand style ----------
Nikita = {
  Magenta   = { 197,  19, 232 },  -- #C513E8
  Purple    = { 122,  27, 232 },  -- #7A1BE8
  Violet    = {  83,  18, 219 },  -- #5312DB
  Orange    = { 255, 138,  30 },  -- #FF8A1E
  Pink      = { 240,  50, 140 },  -- #F0328C
  BG        = {  23,  21,  28 },  -- #17151C
  Panel     = {  32,  29,  38 },  -- #201D26
  Stroke    = {  53,  49,  62 },  -- #35313E
  Text      = { 244, 242, 247 },  -- #F4F2F7
  Muted     = { 167, 159, 179 },  -- #A79FB3
  OK        = {  46, 204, 143 },  -- #2ECC8F
}

BrandName = "Nikita Visual Arts"
BrandSite = "nikitavisual.art"

NikitaAssets = {
  -- 560x202 horizontal logo (PNG, base64)
  Logo = "",
  -- 128x130 icon mark (PNG, base64)
  Icon = "",
}

-- ============================================================
-- Palette (design time AND runtime)
-- ============================================================
-- Sixteen fixed swatches laid out as a 4 x 4 grid. Each entry carries
--   rgb  = the colour the swatch button shows in the schematic / UCI
--   rgbw = the four channel values sent out at 100 % brightness (0..255)
-- Saturated colours drive the RGB emitters only; the two whites use the
-- dedicated W emitter (warm white adds some red/amber on top), and the last
-- swatch is a blackout.
PALETTE = {
  { name = "Red",        rgb = { 255,   0,   0 }, rgbw = { 255,   0,   0,   0 } },
  { name = "Orange",     rgb = { 255,  96,   0 }, rgbw = { 255,  96,   0,   0 } },
  { name = "Amber",      rgb = { 255, 170,   0 }, rgbw = { 255, 170,   0,   0 } },
  { name = "Yellow",     rgb = { 255, 255,   0 }, rgbw = { 255, 255,   0,   0 } },
  { name = "Lime",       rgb = { 128, 255,   0 }, rgbw = { 128, 255,   0,   0 } },
  { name = "Green",      rgb = {   0, 255,   0 }, rgbw = {   0, 255,   0,   0 } },
  { name = "Mint",       rgb = {   0, 255, 128 }, rgbw = {   0, 255, 128,   0 } },
  { name = "Cyan",       rgb = {   0, 255, 255 }, rgbw = {   0, 255, 255,   0 } },
  { name = "Sky",        rgb = {   0, 128, 255 }, rgbw = {   0, 128, 255,   0 } },
  { name = "Blue",       rgb = {   0,   0, 255 }, rgbw = {   0,   0, 255,   0 } },
  { name = "Violet",     rgb = { 128,   0, 255 }, rgbw = { 128,   0, 255,   0 } },
  { name = "Magenta",    rgb = { 255,   0, 255 }, rgbw = { 255,   0, 255,   0 } },
  { name = "Pink",       rgb = { 255,   0, 128 }, rgbw = { 255,   0, 128,   0 } },
  { name = "Warm White", rgb = { 255, 214, 170 }, rgbw = { 255, 140,  40, 255 } },
  { name = "White",      rgb = { 255, 255, 255 }, rgbw = {   0,   0,   0, 255 } },
  { name = "Off",        rgb = { 110, 104, 122 }, rgbw = {   0,   0,   0,   0 } },
}
PALETTE_COLS = 4
PALETTE_ROWS = math.ceil(#PALETTE / PALETTE_COLS)
DEFAULT_SWATCH = 15   -- White

CHANNELS = { "Red", "Green", "Blue", "White" }

-- Output scale property -> knob range / unit / rounding.
OUTPUT_SCALES = {
  ["0-255"] = { max = 255, unit = "Integer", decimals = 0 },
  ["0-100"] = { max = 100, unit = "Percent", decimals = 0 },
  ["0-1"]   = { max = 1,   unit = "Float",   decimals = 3 },
}
OUTPUT_SCALE_NAMES = { "0-255", "0-100", "0-1" }

function GetScale(props)
  local name = props["Output Scale"] and props["Output Scale"].Value or "0-255"
  return OUTPUT_SCALES[name] or OUTPUT_SCALES["0-255"], name
end

function GetColor(props) return Nikita.BG end

function GetPrettyName(props)
  local base = PluginInfo.Name:match("~(.+)$") or PluginInfo.Name
  local _, scaleName = GetScale(props)
  return string.format("%s (%d colours, %s)", base, #PALETTE, scaleName)
end

-- ---------- Properties ----------
function GetProperties()
  return {
    { Name = "Output Scale", Type = "enum", Choices = OUTPUT_SCALE_NAMES, Value = "0-255" },
    { Name = "Debug", Type = "boolean", Value = false },
  }
end

function RectifyProperties(props)
  return props
end

-- ---------- Pages ----------
PageNames = { "Picker" }

function GetPages(props)
  local pages = {}
  for _, name in ipairs(PageNames) do
    table.insert(pages, { name = name })
  end
  return pages
end

-- ---------- Controls ----------
-- The initial value of a plugin control is set with "DefaultValue".
function GetControls(props)
  local scale = GetScale(props)
  local ctls = {}

  table.insert(ctls, { Name = "Status", ControlType = "Indicator", IndicatorType = "Status", PinStyle = "Output", Count = 1 })

  -- One toggle per swatch; the runtime keeps exactly one of them on.
  table.insert(ctls, { Name = "Swatch", ControlType = "Button", ButtonType = "Toggle", Count = #PALETTE, PinStyle = "Both", UserPin = true })
  -- Master brightness, applied to all four channels.
  table.insert(ctls, { Name = "Brightness", ControlType = "Knob", ControlUnit = "Percent", Min = 0, Max = 100, DefaultValue = 100, Count = 1, PinStyle = "Both", UserPin = true })

  -- RGBW outputs (one knob per channel, read-only, control pins out).
  for _, ch in ipairs(CHANNELS) do
    table.insert(ctls, { Name = ch, ControlType = "Knob", ControlUnit = scale.unit, Min = 0, Max = scale.max, DefaultValue = 0, Count = 1, PinStyle = "Output", UserPin = true })
  end
  -- All four values in one string "R,G,B,W" for string-driven controllers.
  table.insert(ctls, { Name = "RGBW", ControlType = "Indicator", IndicatorType = "Text", Count = 1, PinStyle = "Output", UserPin = true })
  -- Name of the active swatch, e.g. "Warm White".
  table.insert(ctls, { Name = "ColorName", ControlType = "Indicator", IndicatorType = "Text", Count = 1, PinStyle = "Output", UserPin = true })
  -- Preview lamp, recoloured by the runtime to the selected colour.
  table.insert(ctls, { Name = "Preview", ControlType = "Indicator", IndicatorType = "Led", Count = 1 })

  return ctls
end

-- ---------- Layout ----------
function GetControlLayout(props)
  local layout, graphics = {}, {}

  -- Brand grid: 8 px base unit, 16 px outer margin, 12 px between
  -- sections, 8 px between controls.
  local HEADER, M, GAP, G = 48, 16, 12, 8

  -- Left panel: the palette grid. Each cell = swatch button + caption.
  local CELL_W, CELL_H = 60, 44
  local PITCH_X, PITCH_Y = CELL_W + G, CELL_H + 14 + G
  local gridW = PALETTE_COLS * PITCH_X - G
  local gridH = PALETTE_ROWS * PITCH_Y - G
  local palX, palY = M, HEADER + GAP
  local palW = gridW + 2 * 12

  -- Right panel: preview, brightness, the four channel values, string.
  -- Row offsets inside the panel (relative to palY).
  local PREV_Y, BR_Y, CH_Y = 32, 92, 156
  local CH_PITCH = 28
  local STR_Y = CH_Y + #CHANNELS * CH_PITCH + 8
  local outX = palX + palW + GAP
  local outW = 232
  -- Both panels share one height: whichever content is taller.
  local palH = math.max(32 + gridH + 12, STR_Y + 12 + 24 + 12)
  local outH = palH

  local W = outX + outW + M
  local H = palY + palH + M

  local function panel(pos, size)
    table.insert(graphics, { Type = "GroupBox", Fill = Nikita.Panel, StrokeColor = Nikita.Stroke, StrokeWidth = 1, CornerRadius = 4, Position = pos, Size = size })
  end

  local function caption(text, pos, size, align)
    table.insert(graphics, { Type = "Label", Text = text, FontSize = 8, FontStyle = "Bold", HTextAlign = align or "Center", Color = Nikita.Muted, Position = pos, Size = size })
  end

  local function title(text, pos, size)
    table.insert(graphics, { Type = "Label", Text = text, FontSize = 10, FontStyle = "Bold", HTextAlign = "Left", Color = Nikita.Muted, Position = pos, Size = size })
  end

  local function dim(rgb, f)
    return { math.floor(rgb[1] * f), math.floor(rgb[2] * f), math.floor(rgb[3] * f) }
  end

  -- Background + header: icon, brand name and website on the left,
  -- plugin name on the right.
  table.insert(graphics, { Type = "GroupBox", Fill = Nikita.BG, StrokeWidth = 0, Position = { 0, 0 }, Size = { W, H } })
  table.insert(graphics, { Type = "GroupBox", Fill = Nikita.Panel, StrokeWidth = 0, CornerRadius = 0, Position = { 0, 0 }, Size = { W, HEADER } })
  table.insert(graphics, { Type = "Image", Image = NikitaAssets.Icon, Position = { M, 11 }, Size = { 26, 26 } })
  table.insert(graphics, { Type = "Label", Text = BrandName, FontSize = 13, FontStyle = "Bold", HTextAlign = "Left", Color = Nikita.Text, Position = { M + 32, 7 }, Size = { 180, 18 } })
  table.insert(graphics, { Type = "Label", Text = BrandSite, FontSize = 9, HTextAlign = "Left", Color = Nikita.Muted, Position = { M + 32, 26 }, Size = { 180, 14 } })
  table.insert(graphics, { Type = "Label", Text = GetPrettyName(props), FontSize = 13, FontStyle = "Bold", HTextAlign = "Right", Color = Nikita.Text, Position = { W - 260 - M - 24, 14 }, Size = { 260, 20 } })
  layout["Status"] = { Style = "Led", Position = { W - M - 16, 16 }, Size = { 16, 16 } }

  -- Signature brand rule along the header's bottom edge: purple -> pink -> orange.
  local seg = math.floor(W / 3)
  table.insert(graphics, { Type = "GroupBox", Fill = Nikita.Purple, StrokeWidth = 0, CornerRadius = 0, Position = { 0, HEADER - 2 }, Size = { seg, 2 } })
  table.insert(graphics, { Type = "GroupBox", Fill = Nikita.Pink, StrokeWidth = 0, CornerRadius = 0, Position = { seg, HEADER - 2 }, Size = { seg, 2 } })
  table.insert(graphics, { Type = "GroupBox", Fill = Nikita.Orange, StrokeWidth = 0, CornerRadius = 0, Position = { 2 * seg, HEADER - 2 }, Size = { W - 2 * seg, 2 } })

  -- ----- Palette panel -----
  panel({ palX, palY }, { palW, palH })
  title("C O L O U R", { palX + 12, palY + 10 }, { palW - 24, 12 })
  for i, sw in ipairs(PALETTE) do
    local col, row = (i - 1) % PALETTE_COLS, math.floor((i - 1) / PALETTE_COLS)
    local x = palX + 12 + col * PITCH_X
    local y = palY + 32 + row * PITCH_Y
    -- Selected = full colour, unselected = the same colour at 45 %.
    layout["Swatch " .. i] = {
      Style = "Button", ButtonStyle = "Toggle", Legend = "",
      Color = sw.rgb, UnlinkOffColor = true, OffColor = dim(sw.rgb, 0.45),
      CornerRadius = 6, Position = { x, y }, Size = { CELL_W, CELL_H },
    }
    caption(string.upper(sw.name), { x - 4, y + CELL_H + 2 }, { CELL_W + 8, 12 })
  end

  -- ----- Output panel -----
  panel({ outX, palY }, { outW, outH })
  title("O U T P U T", { outX + 12, palY + 10 }, { outW - 24, 12 })

  -- Preview lamp + colour name.
  layout["Preview"] = { Style = "Led", Color = PALETTE[DEFAULT_SWATCH].rgb, Position = { outX + 12, palY + PREV_Y }, Size = { 44, 44 } }
  caption("SELECTED", { outX + 64, palY + PREV_Y + 2 }, { outW - 76, 10 }, "Left")
  layout["ColorName"] = { Style = "Text", HTextAlign = "Left", FontSize = 12, IsReadOnly = true, Position = { outX + 64, palY + PREV_Y + 16 }, Size = { outW - 76, 24 } }

  -- Brightness.
  local brY = palY + BR_Y
  caption("BRIGHTNESS", { outX + 12, brY }, { 64, 10 })
  layout["Brightness"] = { Style = "Knob", Color = Nikita.Magenta, Position = { outX + 24, brY + 12 }, Size = { 40, 40 } }

  -- Four channel values, one row each.
  local chY = palY + CH_Y
  local chColors = { { 255, 64, 64 }, { 64, 220, 96 }, { 80, 128, 255 }, { 240, 240, 240 } }
  for c, ch in ipairs(CHANNELS) do
    local ry = chY + (c - 1) * CH_PITCH
    table.insert(graphics, { Type = "GroupBox", Fill = chColors[c], StrokeWidth = 0, CornerRadius = 2, Position = { outX + 12, ry + 6 }, Size = { 4, 12 } })
    table.insert(graphics, { Type = "Label", Text = ch, FontSize = 10, HTextAlign = "Left", Color = Nikita.Text, Position = { outX + 22, ry + 5 }, Size = { 50, 14 } })
    layout[ch] = { Style = "Text", HTextAlign = "Right", FontSize = 11, IsReadOnly = true, Position = { outX + 76, ry }, Size = { outW - 88, 24 } }
  end

  -- Combined string, with the logo to its right.
  local sY = palY + STR_Y
  local strW = outW - 24 - 78 - G
  caption("RGBW STRING", { outX + 12, sY }, { strW, 10 }, "Left")
  layout["RGBW"] = { Style = "Text", HTextAlign = "Left", FontSize = 11, IsReadOnly = true, Position = { outX + 12, sY + 12 }, Size = { strW, 24 } }
  table.insert(graphics, { Type = "Image", Image = NikitaAssets.Logo, Position = { outX + outW - 12 - 78, sY + 10 }, Size = { 78, 28 } })

  return layout, graphics
end

-- ---------- Pins / components / wiring ----------
-- Control-only plugin: no audio pins, no embedded components.
function GetPins(props) return {} end
function GetComponents(props) return {} end
function GetWiring(props) return {} end

-- ============================================================
-- Runtime
-- ============================================================
if Controls then
  print(string.format("%s Color Picker RGBW %s – %s", BrandName, PluginInfo.Version, BrandSite))

  local scale = GetScale(Properties)
  local function debugOn() return Properties["Debug"] and Properties["Debug"].Value end
  local function dbg(...) if debugOn() then print(...) end end

  local Swatch = Controls.Swatch
  local Out = {}
  for _, ch in ipairs(CHANNELS) do Out[ch] = Controls[ch] end

  local current = DEFAULT_SWATCH
  local busy = false   -- guards against re-entrant EventHandlers while we set buttons

  local function toHex(rgb)
    return string.format("#%02X%02X%02X", rgb[1], rgb[2], rgb[3])
  end

  local function scaled(v255, bright)
    local v = v255 / 255 * bright * scale.max
    if scale.decimals == 0 then return math.floor(v + 0.5) end
    local m = 10 ^ scale.decimals
    return math.floor(v * m + 0.5) / m
  end

  local function fmt(v)
    if scale.decimals == 0 then return string.format("%d", v) end
    return string.format("%." .. scale.decimals .. "f", v)
  end

  local function update()
    local sw = PALETTE[current]
    local bright = Controls.Brightness.Value / 100
    local vals = {}
    for c, ch in ipairs(CHANNELS) do
      vals[c] = scaled(sw.rgbw[c], bright)
      Out[ch].Value = vals[c]
      Out[ch].String = fmt(vals[c])
    end
    Controls.RGBW.String = string.format("%s,%s,%s,%s", fmt(vals[1]), fmt(vals[2]), fmt(vals[3]), fmt(vals[4]))
    Controls.ColorName.String = sw.name
    -- Preview shows the swatch colour dimmed by brightness.
    local pr = { math.floor(sw.rgb[1] * bright), math.floor(sw.rgb[2] * bright), math.floor(sw.rgb[3] * bright) }
    Controls.Preview.Color = toHex(pr)
    Controls.Preview.Boolean = (vals[1] + vals[2] + vals[3] + vals[4]) > 0
    Controls.Status.Value = 0
    Controls.Status.String = sw.name .. " @ " .. string.format("%d%%", math.floor(bright * 100 + 0.5))
    dbg(string.format("[Color Picker] %s -> %s", sw.name, Controls.RGBW.String))
  end

  -- Radio behaviour: pressing a swatch turns the others off; un-pressing the
  -- active one is ignored (there is always a selection; use "Off" to black out).
  local function select(i)
    if busy then return end
    busy = true
    current = i
    for k = 1, #PALETTE do
      Swatch[k].Boolean = (k == i)
    end
    busy = false
    update()
  end

  for i = 1, #PALETTE do
    Swatch[i].EventHandler = function(ctl)
      if busy then return end
      if ctl.Boolean then
        select(i)
      elseif i == current then
        busy = true
        ctl.Boolean = true
        busy = false
      end
    end
  end
  Controls.Brightness.EventHandler = update

  -- Start-up: restore whichever swatch the design saved as on, else the default.
  local saved
  for i = 1, #PALETTE do
    if Swatch[i].Boolean then saved = saved or i end
  end
  select(saved or DEFAULT_SWATCH)
end
